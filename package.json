{
  "name": "pi-rex-agents",
  "version": "0.2.0-p3",
  "private": true,
  "type": "module",
  "description": "Rex host adapter for Pi subagents: async children in Rex blocks and tabs",
  "scripts": {
    "p0": "node --experimental-strip-types src/p0.ts",
    "p1": "bun src/p1.ts",
    "p1:worktree": "bun src/p1.ts --worktree",
    "p1:persistent": "bun src/p1.ts --persistent",
    "p2": "bun src/p2.ts",
    "doctor": "bun src/doctor.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && bun src/host-message-check.ts && bun src/wording-check.ts && npm run p0"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "pi-herdr-agents": "^3.7.2"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
